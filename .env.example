# Provider used when a chat request does not explicitly choose one.
AGENT_DEFAULT_PROVIDER=ollama
AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_OLLAMA_MODEL=llama3.2

# OpenAI is optional. Keep the real key in your untracked .env file.
OPENAI_API_KEY=
AGENT_OPENAI_MODEL=gpt-4o-mini

# Maximum model/tool iterations for one user request.
AGENT_MAX_ITERATIONS=5
AGENT_REQUEST_TIMEOUT_SECONDS=90
AGENT_COMMAND_POLICY=allowlist
# Optional additional executable names. Every command still requires approval.
AGENT_EXTRA_COMMAND_NAMES=

# Optional comma-separated workspace exclusions (in addition to .gitignore).
AGENT_EXCLUDE_PATTERNS=
